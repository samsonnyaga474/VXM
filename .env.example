# VXM Environment Configuration
# Copy this file to .env and edit values for your environment.
# Never commit a real .env with secrets to GitHub.

VXM_ENV=development
APP_URL=http://localhost/VXM
APP_DOMAIN=vxm.co.ke

# XAMPP MySQL defaults (empty password is normal for local XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=vxm

# Support (shown on contact, footer, emails)
SUPPORT_EMAIL=fam500473@gmail.com
SUPPORT_PHONE=0715385073

# M-Pesa Send Money number shown to users
MPESA_NUMBER=0715385073
MPESA_TYPE=Send Money

# Business financial settings
MIN_DEPOSIT=100
MIN_WITHDRAWAL=200
WITHDRAWAL_FEE=20
REFERRAL_PERCENTAGE=5
REFERRAL_BONUS_TRIGGER=on_level_purchase

# M-Pesa Daraja API (leave empty for local simulated deposits)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=

# Simulated deposits: only work in development
ALLOW_SIMULATED_DEPOSITS=true

# Email
MAIL_DRIVER=log
MAIL_FROM=noreply@vxm.local
MAIL_FROM_NAME=VXM
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
